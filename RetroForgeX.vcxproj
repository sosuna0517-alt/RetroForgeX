  <ItemDefinitionGroup>
    <ClCompile>
      <!-- Default to NOT using the precompiled header: only App.cpp (which
           already starts with #include "pch.h", per the C++/WinRT app
           template) and pch.cpp itself (which creates it) are wired to it
           below. Every RetroForgeX .cpp and every vendored Dear ImGui .cpp
           in this project does its own #include-what-you-use and doesn't
           start with pch.h, so leaving the old project-wide default of
           PrecompiledHeader=Use on them made MSVC require pch.h as each
           file's very first token and fail with C1010 the moment it wasn't;
           that's what produced a C1010 in essentially every .cpp above. -->
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <PrecompiledHeaderFile>pch.h</PrecompiledHeaderFile>
      <PrecompiledHeaderOutputFile>$(IntDir)pch.pch</PrecompiledHeaderOutputFile>
      <WarningLevel>Level4</WarningLevel>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <!-- The RetroForgeX sources and vendored Dear ImGui sources are
           referenced in place from their Downloads folders (see the
           relative ..\..\..\Downloads\... paths in the ClCompile/ClInclude
           items below) rather than copied into this project directory, so
           their quote-includes ("core/main_loop.hpp", "imgui.h", etc.)
           need these roots on the include search path:
             - RetroForgeX\include  -> core/, drivers/, video/, audio/,
               input/, storage/, util/, libretro/ headers
             - RetroForgeX\src      -> "video/shaders/compiled_shaders.hpp",
               included from d3d12_video.cpp with that sub-path prefix
             - imgui-master\imgui-master -> imgui.h / imconfig.h, included
               by every backends/*.cpp and misc/cpp/imgui_stdlib.cpp -->
      <AdditionalIncludeDirectories>..\..\..\Downloads\RetroForgeX\RetroForgeX\include;..\..\..\Downloads\RetroForgeX\RetroForgeX\src;..\..\..\Downloads\imgui-master\imgui-master;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <AdditionalOptions>%(AdditionalOptions) /bigobj</AdditionalOptions>
      <!-- _SILENCE_EXPERIMENTAL_COROUTINE_DEPRECATION_WARNINGS is a
           fallback only: with LanguageStandard=stdcpp20 above, the cppwinrt
           targets no longer add /await in the first place, so nothing
           should reach <experimental/coroutine> at all.
           NOMINMAX stops <Windows.h> from defining max/min function-like
           macros, which otherwise break every std::max/std::min/std::clamp
           call in this project (d3d12_video.cpp, xaudio2_audio.cpp, ...)
           with a cryptic "'(' illegal token on right side of '::'" error. -->
      <PreprocessorDefinitions>WIN32_LEAN_AND_MEAN;WINRT_LEAN_AND_MEAN;NOMINMAX;_SILENCE_EXPERIMENTAL_COROUTINE_DEPRECATION_WARNINGS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <GenerateWindowsMetadata>false</GenerateWindowsMetadata>
    </Link>
  </ItemDefinitionGroup>
